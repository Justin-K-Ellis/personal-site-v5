---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import  StackSection  from "@components/StackSection.astro";

const progLanguages = [
  "Python",
  "TypeScript/JavaScript",
  "SQL"
]

const backendTech = [
  "FastAPI",
  "Node.js",
  "Express.js",
  "PostgresQL",
  "OpenAI SDK"
]

const frontendTech = [
  "React",
  "Tailwind CSS",
  "daisyUI",
  "Astro"
]


const tooling = [
  "Git, GitHub",
  "Databricks",
  "Vim",
  "Vite",
  "Notion"
]

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Justin.
    </h4>
    <div class="space-y-16">
      <!-- Self intro -->
      <section>
        <article class="space-y-4">
            <p>
                Welcome to my personal site. I'm an AI engineer living and working in Tokyo. I specialize in building backend applications that utilize LLMs and other ML resources. I'm most comfortable working in Python, but I'm also a TypeScript enjoyer and competent enough in React (naturally, I've also dabbled in plenty of other languages and am open to learning just about anything).
            </p>
            <p>
                I also speak English natively and Japanese fluently (having worked in a Japanese office for eight years and using business Japanese daily).
            </p>
            <p>
                Check out my projects, CV, and if you're inclined, blog.
            </p>
        </article>
      </section>


      <!-- Tech Stack -->
      <section class="animate space-y-4">
          <h4 class="font-bold">Tech Stack</h4>
          <!-- Languages -->
          <StackSection title="Programming Languages" listData={progLanguages} />
          <!-- Backend tech -->
          <StackSection title="Backend Technologies" listData={backendTech} />
          <!-- Frontend tech -->
          <StackSection title="Frontend Technologies" listData={frontendTech} />
          <!-- Tooling, etc. -->
          <StackSection title="Tooling, environments, etc." listData={tooling} />
      </section>

      <!-- Contact -->
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
              Reach out any time.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
       </ul>
      </section>
    </div>
  </Container>
</PageLayout>
