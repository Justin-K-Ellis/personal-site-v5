---
interface Props {
  title: string
  listData: string[]
}
const props = Astro.props

---

<div class="flex flex-col gap-1 p-2 shadow border border-gray-400 rounded-sm">
    <h5 class="underline">{props.title}</h5>
    <ul class="flex flex-col gap-0">
        {props.listData.map((data) => {
          return <li>{data}</li>
        })}
    </ul>
</div>
